# Julián y Harim: 

# ajusten y completen las variables que falten
# cuando decidan motor de BD, hosting y autenticación.

# Servidor (API)
NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS para la versión web
CORS_ORIGIN=http://localhost:8080

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waypoint
DB_USER=waypoint_user
DB_PASSWORD=cambia_esta_contrasena

# Autenticación

JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=1d

# Imágenes

# Carpeta donde el servidor guarda las imágenes subidas
UPLOADS_DIR=uploads

# Tamaño máximo por imagen, en MB
MAX_UPLOAD_MB=5
