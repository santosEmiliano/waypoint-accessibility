# Copia este archivo a .env y cambia los valores.
# El .env real nunca se sube al repo.
# Contraseñas solo con letras, números, - y _ (otros caracteres rompen las URL de abajo).

# Servidor (API)
NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS para la versión web
CORS_ORIGIN=http://localhost:8080

# Base de datos (MySQL en Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=waypoint
DB_USER=waypoint_user
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# La que usa Prisma. Si cambias algún valor de arriba, cámbialo aquí también
DATABASE_URL=mysql://waypoint_user:cambia_esta_contrasena@127.0.0.1:3306/waypoint
# Solo para `npm run db:migrate`: BD temporal que Prisma vacía en cada migración.
# La crea Docker (database/init). Usa root con DB_ROOT_PASSWORD
SHADOW_DATABASE_URL=mysql://root:cambia_esta_contrasena_root@127.0.0.1:3306/waypoint_shadow

# Redis (sesiones activas)
REDIS_PORT=6379
REDIS_PASSWORD=cambia_esta_contrasena_redis
REDIS_URL=redis://default:cambia_esta_contrasena_redis@127.0.0.1:6379

# Autenticación

JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=8h

# Semillas: operador de prueba, solo para desarrollo
SEED_OPERADOR_CORREO=operador@waypoint.local
SEED_OPERADOR_CONTRASENA=Operador123!

# Imágenes

# Carpeta donde el servidor guarda las imágenes subidas
UPLOADS_DIR=uploads

# Tamaño máximo por imagen, en MB
MAX_UPLOAD_MB=5
